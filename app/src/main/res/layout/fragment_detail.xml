<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Breadcrumb Bar with categories (similar to item_article) -->
        <LinearLayout
            android:id="@+id/breadcrumb_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:paddingHorizontal="8dp"
            android:background="?android:attr/colorBackground"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject Name"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>

            <TextView
                android:id="@+id/arrow_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ►  "
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"/>

            <TextView
                android:id="@+id/text_subclass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subclass"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorPrimary"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"/>
        </LinearLayout>

        <!-- Category badges (like in item_article) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:id="@+id/categoriesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"/>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="8dp" />

        <!-- arXiv ID -->
        <TextView
            android:id="@+id/article_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="arXiv:2101.10508"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <!-- Paper Title -->
        <TextView
            android:id="@+id/paper_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paper Title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginTop="8dp" />

        <!-- Authors -->
        <TextView
            android:id="@+id/paper_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Author(s): "
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <!-- Submitted Date -->
        <TextView
            android:id="@+id/paper_submitted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submitted: Jan 26, 2021"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="6dp" />

        <!-- Abstract/Summary -->
        <TextView
            android:id="@+id/paper_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abstract"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/paper_summary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summary text goes here..."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp" />

        <!-- DOI (if available) -->
        <TextView
            android:id="@+id/paper_doi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:textStyle="italic"
            android:background="?android:attr/selectableItemBackground"
            android:padding="4dp"/>

        <!-- Action Icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <!-- Download container with icon and progress -->
            <LinearLayout
                android:id="@+id/download_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="40dp"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/download_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/download_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/download"
                    app:tint="?android:attr/textColorPrimary"
                    android:contentDescription="Download" />

            </LinearLayout>

            <ImageView
                android:id="@+id/bookmark_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bookmark"
                app:tint="?android:attr/textColorPrimary"
                android:contentDescription="Bookmark"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- READ button -->
        <TextView
            android:id="@+id/read_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READ"
            android:textStyle="bold"
            android:textColor="?android:attr/colorBackground"
            android:textSize="18sp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_read_button"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>