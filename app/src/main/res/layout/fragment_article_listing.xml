<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Filter/Sort Controls (inline style from search) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_by"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sortSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="120dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="asd"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"/>

        <Spinner
            android:id="@+id/pageSizeSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"/>

    </LinearLayout>

    <!-- Results Count -->
    <TextView
        android:id="@+id/resultsCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingBottom="6dp"
        android:visibility="gone"/>

    <!-- Page Info Text (Top) -->
    <TextView
        android:id="@+id/pageInfoTextTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorPrimary"
        android:paddingBottom="6dp"
        android:visibility="gone"/>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Error text -->
    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/holo_red_dark"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/error_loading_data" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Pagination Controls (advanced from search) -->
    <LinearLayout
        android:id="@+id/bottomPaginationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <!-- Prev/Next with Page Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="12dp">

            <!-- Previous Button -->
            <Button
                android:id="@+id/prevPageButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="asd"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <!-- Page Info Text (Bottom) -->
            <TextView
                android:id="@+id/pageInfoTextBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"/>

            <!-- Next Button -->
            <Button
                android:id="@+id/nextPageButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/next"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="?android:attr/buttonBarButtonStyle"/>
        </LinearLayout>

        <!-- Page Number Buttons (7 buttons with ellipsis support) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/pageButton1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="1"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/pageButton2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="2"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/pageButton3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="3"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/pageButton4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="4"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/pageButton5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="5"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/pageButton6"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="6"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginEnd="4dp"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/pageButton7"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="7"
                android:textSize="14sp"
                android:padding="0dp"
                android:layout_marginEnd="8dp"
                style="?android:attr/buttonBarButtonStyle"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>